# Vite Configuration
PORT=3001

# API Configuration
# URL base de la API REST
VITE_API_URL=http://localhost:3000/api/v1

# URL para conexiones WebSocket (Socket.IO)
VITE_SOCKET_URL=http://localhost:3000

# Notas:
# - Las variables VITE_* son accesibles en el cliente a través de import.meta.env
# - Cambia localhost por la IP del servidor en producción
# - Para desarrollo con dispositivos en red local usa tu IP: http://192.168.X.X:3000
